{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blackjack-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  "exports": {
    "RoomDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
